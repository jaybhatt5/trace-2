# TRACE AI - Environment Configuration Template
# Duplicate this file to .env and fill in your values. Never commit actual secret keys!

# ==============================================================================
# 1. CORE AI ENGINES & UPSTREAM GATEWAYS
# ==============================================================================
# Google Gemini Generative AI Key (required for LLM & multimodal analysis)
GEMINI_API_KEY="your-gemini-api-key-here"

# GNews Live News Wire API Key (https://gnews.io/)
GNEWS_API_KEY="your-gnews-api-key-here"

# Optional path to fine-tuned deepfake PyTorch model weights (.pt/.pth)
DEEPFAKE_MODEL_PATH=""

# Internal token securing local Python AI engine (port 5001)
INTERNAL_AI_SECRET="generate-a-random-32-byte-hex-token-here"

# ==============================================================================
# 2. SERVER & NETWORKING
# ==============================================================================
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# ==============================================================================
# 3. TRACE NATIVE AUTHENTICATION & RBAC ENGINE (Replaces Firebase Auth)
# ==============================================================================
# High-entropy cryptographic secret for signing short-lived JWT access tokens (15m)
# Generate using: openssl rand -hex 32
AUTH_JWT_SECRET="generate-a-secure-random-64-character-hex-string"

# AES-256 encryption key for securing TOTP multi-factor secrets in the database
AUTH_MFA_SECRET="generate-a-secure-random-64-character-hex-string"

# Production Administrator Bootstrap (used only on first startup when no admin exists)
# Forced password change and MFA setup are enforced on first login
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_INITIAL_PASSWORD="SecureMasterAdminPassword123!"

# Master operations session signing secret
ADMIN_SESSION_SECRET="generate-a-secure-random-64-character-hex-string"

# Optional: Third-Party Google OAuth Credentials (for direct Google sign-in)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ==============================================================================
# 4. LEGACY FIREBASE CONFIGURATION (Optional fallback during cutover)
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
