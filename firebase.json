{
  "apphosting": {
    "backendId": "trace-ai",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".env*",
      "AUDIT/**",
      "eval/**",
      "*.pem",
      "*.key",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "TRACE AI - News & Authenticity Engine",
        "supportEmail": "support@trace.ai"
      },
      "emailPassword": true
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "dataconnect": {
    "source": "dataconnect"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
